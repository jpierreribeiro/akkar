#!/usr/bin/env lua
--[[
akkar — the command line.

One subcommand so far, and it is the one that answers the question a Lua
project actually gets stuck on: **is this machine's combination of libraries
one that works?**

    akkar doctor                    what is installed, and what will bite
    akkar doctor app.lua            and this application's configuration
    akkar doctor app.lua --json     the same, for something that parses
    akkar doctor app.lua --no-probe without touching the database

`app.lua` is any file that returns the app, optionally with the config
`app:run{}` would receive:

    local app = require("akkar").new()
    app:get("/health", function() return { ok = true } end)
    return app, { db = db.connect { ... }, reuseport = true }

Exit code is 0 when nothing is broken and 1 when something is, so a deploy
step can gate on it. A warning is not a failure: "luaossl is not installed"
must not block a service that speaks plain HTTP.
]]

local USAGE = [[
akkar — an application runtime for backend services in Lua

usage:
  akkar doctor [app.lua] [--json] [--no-probe]

    Reports the runtime, the installed libraries, this application's routes
    and settings, and whether its capabilities answer. Exits 1 if anything is
    broken.

    app.lua      a file returning `app` or `app, config`
    --json       machine-readable output
    --no-probe   skip anything that touches the network

  akkar build app.lua [options]

    Emits a C host embedding the Lua VM, every module the application needs
    and every native module, and links it into ONE EXECUTABLE. Deployment
    then needs no Lua, no LuaRocks and no shared objects.

    -o NAME         output binary          (default: the entry file's name)
    --root DIR      a directory of Lua modules to embed; repeatable.
                    The first root wins, so an application can shadow a
                    library module by listing its own directory first
    --archive A.a   a static archive of native modules; repeatable
    --lua-lib PATH  liblua.a
    --lua-inc DIR   the directory holding lua.h
    --libs "..."    extra linker flags     (default: -lm -ldl -lpthread)
    --cc NAME       the compiler           (default: $CC, or cc)
    --c-only        write the C and stop, without compiling

  akkar version
  akkar help
]]

local function fail(message)
  io.stderr:write("akkar: " .. message .. "\n")
  os.exit(2)
end

local function load_app(path)
  local chunk, err = loadfile(path)
  if not chunk then fail("could not load " .. path .. ": " .. tostring(err)) end

  local ok, app, config = pcall(chunk)
  if not ok then fail("loading " .. path .. " raised: " .. tostring(app)) end
  if type(app) ~= "table" or type(app.routes) ~= "table" then
    fail(path .. " must return the value akkar.new() returned; got " ..
         type(app) .. ".\n  Add `return app` at the end, or `return app, config`.")
  end
  return app, config
end

local function doctor(args)
  local path, options = nil, { exit = true }
  for _, arg in ipairs(args) do
    if arg == "--json" then options.json = true
    elseif arg == "--no-probe" then options.probe = false
    elseif arg:sub(1, 2) == "--" then fail("unknown option " .. arg)
    else path = arg end
  end

  if path then options.app, options.config = load_app(path) end
  require("akkar.doctor").cli(options)
end

local function build(args)
  local options = {
    roots = {}, archives = {},
    libs = "-lm -ldl -lpthread",
  }

  local i = 1
  local function value(flag)
    i = i + 1
    if not args[i] then fail(flag .. " needs a value") end
    return args[i]
  end

  while i <= #args do
    local a = args[i]
    if     a == "-o"        then options.output = value(a)
    elseif a == "--root"    then options.roots[#options.roots + 1] = value(a)
    elseif a == "--archive" then options.archives[#options.archives + 1] = value(a)
    elseif a == "--lua-lib" then options.lua_library = value(a)
    elseif a == "--lua-inc" then options.lua_include = value(a)
    elseif a == "--libs"    then options.libs = value(a)
    elseif a == "--cc"      then options.cc = value(a)
    elseif a == "--c-only"  then options.compile = false
    elseif a:sub(1, 1) == "-" then fail("unknown option " .. a)
    else options.entry = a end
    i = i + 1
  end

  if not options.entry then fail("build needs an entry file: akkar build app.lua") end
  if not options.output then
    options.output = (options.entry:gsub("^.*/", ""):gsub("%.lua$", ""))
  end

  -- akkar embeds ITSELF without being told to. Anything else the application
  -- needs is a root the caller names, because guessing at a dependency tree
  -- is how a build silently omits a module and fails on the target.
  local own = package.searchpath("akkar", package.path)
  if own then
    options.roots[#options.roots + 1] = own:gsub("/akkar/init%.lua$", "")
                                           :gsub("/akkar%.lua$", "")
  end

  if options.compile ~= false then
    if not options.lua_library then fail("build needs --lua-lib (the path to liblua.a)") end
    if not options.lua_include then fail("build needs --lua-inc (where lua.h lives)") end
  end

  local result, why = require("akkar.build").run(options)
  if not result then fail(why) end

  io.write(("akkar build: %d Lua modules, %d native modules -> %s\n")
           :format(result.modules.lua, result.modules.native,
                   result.binary or result.c))
end

local function archive(args)
  local options = { lua_api = "5.4" }

  local i = 1
  local function value(flag)
    i = i + 1
    if not args[i] then fail(flag .. " needs a value") end
    return args[i]
  end

  while i <= #args do
    local a = args[i]
    if     a == "--source"  then options.source = value(a)
    elseif a == "--lua-inc" then options.lua_include = value(a)
    elseif a == "--lua-api" then options.lua_api = value(a)
    elseif a == "-o"        then options.output = value(a)
    elseif a == "--cc"      then options.cc = value(a)
    elseif a:sub(1, 1) == "-" then fail("unknown option " .. a)
    else options.recipe = a end
    i = i + 1
  end

  if not options.recipe then
    fail("archive needs a library: akkar archive cqueues --source DIR\n" ..
         "  known: cqueues, luaossl, lua-cjson, lpeg")
  end
  if not options.source then fail("archive needs --source (the unpacked source)") end
  if not options.lua_include then fail("archive needs --lua-inc (where lua.h lives)") end
  options.output = options.output or (options.recipe .. ".a")

  local result, why = require("akkar.build").archive(options)
  if not result then fail(why) end

  io.write(("akkar archive: %d objects -> %s\n")
           :format(result.objects, result.archive))
end

local function watch(args)
  local roots, run_command = {}, nil
  local options = {}

  local i = 1
  local function value(flag)
    i = i + 1
    if not args[i] then fail(flag .. " needs a value") end
    return args[i]
  end

  while i <= #args do
    local a = args[i]
    if     a == "--root"     then roots[#roots + 1] = value(a)
    elseif a == "--interval" then options.interval = tonumber(value(a))
    elseif a == "--pattern"  then options.pattern = value(a)
    elseif a == "--" then
      run_command = table.concat({ table.unpack(args, i + 1) }, " ")
      break
    elseif a:sub(1, 1) == "-" then fail("unknown option " .. a)
    else fail("watch takes options and then `-- <command>`") end
    i = i + 1
  end

  if not run_command or run_command == "" then
    fail("watch needs a command after `--`:\n" ..
         "  akkar watch --root . -- ./myapp run app.lua")
  end
  if #roots == 0 then roots = { "." } end

  io.write(("akkar watch: %s\n  roots: %s\n")
           :format(run_command, table.concat(roots, ", ")))

  require("akkar.watch").run(run_command, roots, {
    interval = options.interval,
    pattern = options.pattern,
    on_restart = function(changes)
      io.write(("akkar watch: %d file(s) changed, restarting -- %s\n")
               :format(#changes, changes[1]))
    end,
  })
end

local command = arg[1]
local rest = { table.unpack(arg, 2) }

if command == "doctor" then
  doctor(rest)
elseif command == "watch" then
  watch(rest)
elseif command == "build" then
  build(rest)
elseif command == "archive" then
  archive(rest)
elseif command == "version" then
  print("akkar dev-1 on " .. _VERSION)
elseif command == nil or command == "help" or command == "--help" or command == "-h" then
  print(USAGE)
else
  io.stderr:write("akkar: unknown command '" .. tostring(command) .. "'\n\n" .. USAGE)
  os.exit(2)
end
