#!/usr/bin/env lua
--[[
akkar — the command line.

One subcommand so far, and it is the one that answers the question a Lua
project actually gets stuck on: **is this machine's combination of libraries
one that works?**

    akkar doctor                    what is installed, and what will bite
    akkar doctor app.lua            and this application's configuration
    akkar doctor app.lua --json     the same, for something that parses
    akkar doctor app.lua --no-probe without touching the database

`app.lua` is any file that returns the app, optionally with the config
`app:run{}` would receive:

    local app = require("akkar").new()
    app:get("/health", function() return { ok = true } end)
    return app, { db = db.connect { ... }, reuseport = true }

Exit code is 0 when nothing is broken and 1 when something is, so a deploy
step can gate on it. A warning is not a failure: "luaossl is not installed"
must not block a service that speaks plain HTTP.
]]

local USAGE = [[
akkar — an application runtime for backend services in Lua

usage:
  akkar new NAME

    Creates a project that runs: an app, a spec, a migrations directory and a
    README. Refuses to overwrite an existing one.

  akkar run [app.lua] [--watch] [--root DIR]

    Loads the file and starts it, with signal handling installed. The file
    returns `app` or `app, config` -- the same shape doctor and build read.

    --watch      restart when a file changes
    --root DIR   what to watch; repeatable, defaults to .

  akkar test [busted options]

    Runs busted over spec/ with package.path pointing at this project.

  akkar doctor [app.lua] [--json] [--no-probe]

    Reports the runtime, the installed libraries, this application's routes
    and settings, and whether its capabilities answer. Exits 1 if anything is
    broken.

    app.lua      a file returning `app` or `app, config`
    --json       machine-readable output
    --no-probe   skip anything that touches the network

  akkar build app.lua [options]

    Emits a C host embedding the Lua VM, every module the application needs
    and every native module, and links it into ONE EXECUTABLE. Deployment
    then needs no Lua, no LuaRocks and no shared objects.

    -o NAME         output binary          (default: the entry file's name)
    --root DIR      a directory of Lua modules to embed; repeatable.
                    The first root wins, so an application can shadow a
                    library module by listing its own directory first
    --archive A.a   a static archive of native modules; repeatable
    --lua-lib PATH  liblua.a
    --lua-inc DIR   the directory holding lua.h
    --libs "..."    extra linker flags     (default: -lm -ldl -lpthread)
    --cc NAME       the compiler           (default: $CC, or cc)
    --c-only        write the C and stop, without compiling

  akkar gen app.lua [-o client.ts] [--check] [--title T] [--version V]

    Generates a typed TypeScript client from the route schemas, through the
    same OpenAPI document `akkar.openapi` serves. A wrong field in a call is
    then a tsc error, not a 422. Writes to stdout without -o.

    --check      exit 1 if the file at -o differs from what would be generated;
                 for CI, so a schema change nobody regenerated fails the build

  akkar version
  akkar help
]]

local function fail(message)
  io.stderr:write("akkar: " .. message .. "\n")
  os.exit(2)
end

local function load_app(path)
  local chunk, err = loadfile(path)
  if not chunk then fail("could not load " .. path .. ": " .. tostring(err)) end

  local ok, app, config = pcall(chunk)
  if not ok then fail("loading " .. path .. " raised: " .. tostring(app)) end
  if type(app) ~= "table" or type(app.routes) ~= "table" then
    fail(path .. " must return the value akkar.new() returned; got " ..
         type(app) .. ".\n  Add `return app` at the end, or `return app, config`.")
  end
  return app, config
end

local function doctor(args)
  local path, options = nil, { exit = true }
  for _, arg in ipairs(args) do
    if arg == "--json" then options.json = true
    elseif arg == "--no-probe" then options.probe = false
    elseif arg:sub(1, 2) == "--" then fail("unknown option " .. arg)
    else path = arg end
  end

  if path then options.app, options.config = load_app(path) end
  require("akkar.doctor").cli(options)
end

local function build(args)
  local options = {
    roots = {}, archives = {},
    libs = "-lm -ldl -lpthread",
  }

  local i = 1
  local function value(flag)
    i = i + 1
    if not args[i] then fail(flag .. " needs a value") end
    return args[i]
  end

  while i <= #args do
    local a = args[i]
    if     a == "-o"        then options.output = value(a)
    elseif a == "--root"    then options.roots[#options.roots + 1] = value(a)
    elseif a == "--archive" then options.archives[#options.archives + 1] = value(a)
    elseif a == "--lua-lib" then options.lua_library = value(a)
    elseif a == "--lua-inc" then options.lua_include = value(a)
    elseif a == "--libs"    then options.libs = value(a)
    elseif a == "--cc"      then options.cc = value(a)
    elseif a == "--c-only"  then options.compile = false
    elseif a:sub(1, 1) == "-" then fail("unknown option " .. a)
    else options.entry = a end
    i = i + 1
  end

  if not options.entry then fail("build needs an entry file: akkar build app.lua") end
  if not options.output then
    options.output = (options.entry:gsub("^.*/", ""):gsub("%.lua$", ""))
  end

  -- akkar embeds ITSELF without being told to. Anything else the application
  -- needs is a root the caller names, because guessing at a dependency tree
  -- is how a build silently omits a module and fails on the target.
  local own = package.searchpath("akkar", package.path)
  if own then
    options.roots[#options.roots + 1] = own:gsub("/akkar/init%.lua$", "")
                                           :gsub("/akkar%.lua$", "")
  end

  if options.compile ~= false then
    if not options.lua_library then fail("build needs --lua-lib (the path to liblua.a)") end
    if not options.lua_include then fail("build needs --lua-inc (where lua.h lives)") end
  end

  local result, why = require("akkar.build").run(options)
  if not result then fail(why) end

  io.write(("akkar build: %d Lua modules, %d native modules -> %s\n")
           :format(result.modules.lua, result.modules.native,
                   result.binary or result.c))
end

local function archive(args)
  local options = { lua_api = "5.4" }

  local i = 1
  local function value(flag)
    i = i + 1
    if not args[i] then fail(flag .. " needs a value") end
    return args[i]
  end

  while i <= #args do
    local a = args[i]
    if     a == "--source"  then options.source = value(a)
    elseif a == "--lua-inc" then options.lua_include = value(a)
    elseif a == "--lua-api" then options.lua_api = value(a)
    elseif a == "-o"        then options.output = value(a)
    elseif a == "--cc"      then options.cc = value(a)
    elseif a:sub(1, 1) == "-" then fail("unknown option " .. a)
    else options.recipe = a end
    i = i + 1
  end

  if not options.recipe then
    fail("archive needs a library: akkar archive cqueues --source DIR\n" ..
         "  known: cqueues, luaossl, lua-cjson, lpeg")
  end
  if not options.source then fail("archive needs --source (the unpacked source)") end
  if not options.lua_include then fail("archive needs --lua-inc (where lua.h lives)") end
  options.output = options.output or (options.recipe .. ".a")

  local result, why = require("akkar.build").archive(options)
  if not result then fail(why) end

  io.write(("akkar archive: %d objects -> %s\n")
           :format(result.objects, result.archive))
end

local function watch(args)
  local roots, run_command = {}, nil
  local options = {}

  local i = 1
  local function value(flag)
    i = i + 1
    if not args[i] then fail(flag .. " needs a value") end
    return args[i]
  end

  while i <= #args do
    local a = args[i]
    if     a == "--root"     then roots[#roots + 1] = value(a)
    elseif a == "--interval" then options.interval = tonumber(value(a))
    elseif a == "--pattern"  then options.pattern = value(a)
    elseif a == "--" then
      run_command = table.concat({ table.unpack(args, i + 1) }, " ")
      break
    elseif a:sub(1, 1) == "-" then fail("unknown option " .. a)
    else fail("watch takes options and then `-- <command>`") end
    i = i + 1
  end

  if not run_command or run_command == "" then
    fail("watch needs a command after `--`:\n" ..
         "  akkar watch --root . -- ./myapp run app.lua")
  end
  if #roots == 0 then roots = { "." } end

  io.write(("akkar watch: %s\n  roots: %s\n")
           :format(run_command, table.concat(roots, ", ")))

  require("akkar.watch").run(run_command, roots, {
    interval = options.interval,
    pattern = options.pattern,
    on_restart = function(changes)
      io.write(("akkar watch: %d file(s) changed, restarting -- %s\n")
               :format(#changes, changes[1]))
    end,
  })
end

-- ===================================================================== new
--
-- The first minute with a runtime decides whether there is a second one, and
-- Lua's has historically been: choose an interpreter, a package manager, an
-- event loop, an HTTP library, a TLS library, a JSON library and a Postgres
-- driver, then find out which combination works. `akkar new` answers all of
-- that by producing a project that runs.
--
-- Deliberately small. A scaffold that emits twelve files teaches its own
-- layout instead of the framework, and every one of them is a file somebody
-- has to read before they can delete it.
local SCAFFOLD = {
  ["app.lua"] = [[
-- Return the app, and the configuration `app:run` should get. `akkar run`,
-- `akkar doctor` and `akkar build` all load this file the same way, so one
-- shape serves development, diagnosis and deployment.
local akkar = require "akkar"

local app = akkar.new()

app:get("/health", function()
  return { ok = true }
end)

app:get("/hello/:name", { params = { name = akkar.v.string { min = 1, max = 40 } } },
  function(req)
    return { hello = req.params.name }
  end)

return app, {
  port = tonumber(os.getenv "PORT") or 8080,

  -- Uncomment when you add a database, and `akkar doctor app.lua` will tell
  -- you whether it answers.
  -- db = require("akkar.db").connect {
  --   host = os.getenv "PGHOST" or "127.0.0.1",
  --   database = os.getenv "PGDATABASE" or "%s",
  --   user = os.getenv "PGUSER" or "postgres",
  --   password = os.getenv "PGPASSWORD",
  -- },
}
]],

  ["spec/app_spec.lua"] = [[
-- `app:test()` runs a request through the whole chain -- routing, validation,
-- middleware -- without opening a socket, so a test is fast and still real.
package.path = "./?.lua;./?/init.lua;" .. package.path

local app = require "app"

describe("%s", function()
  local client = app:test()

  it("is healthy", function()
    local res = client:get "/health"
    assert.equal(200, res.status)
    assert.is_true(res.body.ok)
  end)

  it("greets", function()
    assert.equal("world", client:get("/hello/world").body.hello)
  end)

  it("refuses a name it was told not to accept", function()
    -- 422 before the handler runs, with the failing field named.
    local res = client:get("/hello/" .. string.rep("x", 100))
    assert.equal(422, res.status)
    assert.is_truthy(res.body.fields["params.name"])
  end)
end)
]],

  ["migrations/.keep"] = "",

  ["README.md"] = [[
# %s

    akkar run          start it, on PORT or 8080
    akkar run --watch  and restart when a file changes
    akkar test         run spec/
    akkar doctor app.lua   what is installed and whether it answers
    akkar build app.lua    one executable, no Lua needed to run it

SQL migrations go in `migrations/`, named so they sort in the order they
should run -- `20260101120000_users.sql`. `akkar.migrate` applies them.
]],
}

local function new(args)
  local name
  for _, a in ipairs(args) do
    if a:sub(1, 1) == "-" then fail("unknown option " .. a) else name = a end
  end
  if not name then fail("new needs a name: akkar new my-api") end
  if name:find "[^%w._-]" then
    fail("'" .. name .. "' has characters a directory should not: use letters, " ..
         "digits, dot, dash and underscore")
  end

  -- REFUSING TO WRITE OVER SOMETHING is the whole of the safety here. A
  -- scaffold that overwrites is a scaffold that eats an afternoon's work the
  -- first time somebody runs it in the wrong directory.
  local probe = io.open(name .. "/app.lua", "r")
  if probe then
    probe:close()
    fail(name .. "/app.lua already exists; refusing to overwrite it")
  end

  for path, template in pairs(SCAFFOLD) do
    local full = name .. "/" .. path
    local dir = full:match "^(.*)/[^/]*$"
    if dir then os.execute(("mkdir -p %q"):format(dir)) end
    local file, err = io.open(full, "w")
    if not file then fail("could not write " .. full .. ": " .. tostring(err)) end
    file:write((template:gsub("%%s", name)))
    file:close()
  end

  io.write(("created %s\n\n  cd %s\n  akkar run\n\nthen: curl localhost:8080/health\n")
           :format(name, name))
end

-- ===================================================================== run
--
-- The same file `doctor` and `build` read, started. It exists so that
-- development uses the runtime deployment will use, rather than a `lua app.lua`
-- that happens to work because of what is in this shell's LUA_PATH.
local function run(args)
  local path, watching, roots = nil, false, {}
  local i = 1
  while i <= #args do
    local a = args[i]
    if a == "--watch" then watching = true
    elseif a == "--root" then
      i = i + 1
      if not args[i] then fail("--root needs a directory") end
      roots[#roots + 1] = args[i]
    elseif a:sub(1, 1) == "-" then fail("unknown option " .. a)
    else path = a end
    i = i + 1
  end
  path = path or "app.lua"

  if watching then
    -- Restarting is done by re-running THIS command without `--watch`, so the
    -- watched process and the plain one are the same process, started the same
    -- way. A reload that runs something subtly different is a reload that
    -- hides the bug it was supposed to show you.
    if #roots == 0 then roots = { "." } end
    local self = arg[0] or "akkar"
    io.write(("akkar run: watching %s\n"):format(table.concat(roots, ", ")))
    return require("akkar.watch").run(
      ("%q run %q"):format(self, path), roots, {
        on_restart = function(changes)
          io.write(("akkar run: %s changed, restarting\n"):format(changes[1]))
        end,
      })
  end

  local app, config = load_app(path)
  app:handle_signals()
  return app:run(config or {})
end

-- ==================================================================== test
--
-- A thin wrapper over busted rather than a runner of our own. Writing one
-- would mean owning assertions, output formats and a plugin surface, to
-- replace something every Lua developer already has.
--
-- What it adds is the part people get wrong: `package.path` pointing at the
-- project, so `require "app"` in a spec finds the app.
local function test(args)
  local passthrough = table.concat(args, " ")
  local busted = os.getenv "BUSTED" or "busted"

  local probe = io.popen(("command -v %q 2>/dev/null"):format(busted))
  local found = probe and probe:read "l"
  if probe then probe:close() end
  if not found or found == "" then
    fail("busted is not installed, and `akkar test` runs it.\n" ..
         "  luarocks install --local busted\n" ..
         "  Or set BUSTED=/path/to/busted.")
  end

  local command = ("%q --lpath='./?.lua;./?/init.lua;;' %s"):format(found, passthrough)
  local ok, how, code = os.execute(command)
  if ok then os.exit(0) end
  os.exit(how == "exit" and code or 1)
end

-- ===================================================================== gen
--
-- The generated client is only as current as the last run of this command,
-- which is the honest cost of generating types rather than inferring them.
-- `--check` is what makes that cost visible: it regenerates in memory and
-- compares against the committed file, so a route schema that changed without
-- anybody regenerating is a red CI step rather than a client that type-checks
-- green against a contract the server no longer honours.
local function gen(args)
  local path, output, checking = nil, nil, false
  local info = {}

  local i = 1
  local function value(flag)
    i = i + 1
    if not args[i] then fail(flag .. " needs a value") end
    return args[i]
  end

  while i <= #args do
    local a = args[i]
    if     a == "-o"        then output = value(a)
    elseif a == "--check"   then checking = true
    elseif a == "--title"   then info.title = value(a)
    elseif a == "--version" then info.version = value(a)
    elseif a:sub(1, 1) == "-" then fail("unknown option " .. a)
    else path = a end
    i = i + 1
  end

  if not path then fail("gen needs an app file: akkar gen app.lua -o client.ts") end
  if checking and not output then fail("--check needs -o, the file to compare against") end

  local app = load_app(path)
  local generated = require("akkar.gen").typescript(app, info)

  if checking then
    local file = io.open(output, "r")
    local current = file and file:read "a"
    if file then file:close() end
    if current ~= generated then
      io.stderr:write(("akkar gen: %s is out of date -- the route schemas changed.\n"
                    .. "  Regenerate and commit:  akkar gen %s -o %s\n"):format(output, path, output))
      os.exit(1)
    end
    io.write(("akkar gen: %s is up to date\n"):format(output))
    return
  end

  if output then
    local file, err = io.open(output, "w")
    if not file then fail("could not write " .. output .. ": " .. tostring(err)) end
    file:write(generated)
    file:close()
    io.write(("akkar gen: %s\n"):format(output))
  else
    io.write(generated)
  end
end

local command = arg[1]
local rest = { table.unpack(arg, 2) }

if command == "doctor" then
  doctor(rest)
elseif command == "new" then
  new(rest)
elseif command == "run" then
  run(rest)
elseif command == "test" then
  test(rest)
elseif command == "watch" then
  watch(rest)
elseif command == "build" then
  build(rest)
elseif command == "archive" then
  archive(rest)
elseif command == "gen" then
  gen(rest)
elseif command == "version" then
  print("akkar dev-1 on " .. _VERSION)
elseif command == nil or command == "help" or command == "--help" or command == "-h" then
  print(USAGE)
else
  io.stderr:write("akkar: unknown command '" .. tostring(command) .. "'\n\n" .. USAGE)
  os.exit(2)
end
