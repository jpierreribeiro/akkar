ML_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
ML_DATABASE_URL=postgresql://akkar:akkar@postgres:5432/akkar_ml
ML_REDIS_URL=redis://redis:6379/0
ML_MLFLOW_TRACKING_URI=http://mlflow:5000
ML_MODEL_NAME=akkar-reference
ML_MODEL_ALIAS=champion
ML_S3_ENDPOINT_URL=http://minio:9000
ML_S3_ACCESS_KEY=minio
ML_S3_SECRET_KEY=replace-this-minio-secret
ML_S3_REGION=us-east-1
ML_INPUT_BUCKET=ml-batch
ML_OUTPUT_BUCKET=ml-batch
ML_REQUIRE_MODEL_DIGEST=true
ML_MAX_BODY_BYTES=1048576
ML_MAX_BATCH_INPUT_BYTES=67108864
ML_MAX_BATCH_OUTPUT_BYTES=134217728
ML_MAX_BATCH_ROWS=100000
ML_BATCH_TASK_TIME_LIMIT_SECONDS=900
# Gateway-only: private file of hashes, tenants, permissions and model allowlists.
ML_CLIENT_KEYS_FILE=/absolute/path/to/client-keys.json
MLFLOW_HTTP_REQUEST_TIMEOUT=5
MLFLOW_HTTP_REQUEST_MAX_RETRIES=0
