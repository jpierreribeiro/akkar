local function encode_component(s: string): string
  return (s:gsub("[^%w%-_%.~]", function(c: string): string
    return ("%%%02X"):format(c:byte())
  end))
end

local function fill(path: string, name: string, value: any): string
  local start, stop = path:find("{" .. name .. "}", 1, true)
  if not start then return path end
  return path:sub(1, start - 1) .. encode_component(tostring(value)) .. path:sub(stop + 1)
end

local function build_query(query: {string: any}): string
  if query == nil then return "" end
  local keys: {string} = {}
  for k in pairs(query) do keys[#keys + 1] = k end
  table.sort(keys)
  local parts: {string} = {}
  for _, k in ipairs(keys) do
    parts[#parts + 1] = encode_component(k) .. "=" .. encode_component(tostring(query[k]))
  end
  if #parts == 0 then return "" end
  return "?" .. table.concat(parts, "&")
end

local function send(options: client.Options, method: string, path: string, body: any): integer, any
  return options.transport({
    method = method,
    path = (options.base_url or "") .. path,
    body = body,
    headers = options.headers or {},
  })
end

function client.new(options: client.Options): client.Client
  assert(options and options.transport, "client.new needs options.transport")
  return setmetatable({ options = options } as client.Client, { __index = client.Client })
end

function client.Client:post_transfers(args: client.PostTransfersArgs): client.PostTransfersResponse, client.PostTransfersError
  local path = "/transfers"
  local status, body = send(self.options, "POST", path, args.body)
  if status < 200 or status >= 300 then
    return nil, { status = status, body = body as client.PostTransfersErrorBody }
