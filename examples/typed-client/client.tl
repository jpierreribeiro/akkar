end

function client.Client:get_users(args?: client.GetUsersArgs): client.GetUsersResponse, client.GetUsersError
  local path = "/users"
  local query: {string: any}
  if args and args.query then query = args.query as {string: any} end
  path = path .. build_query(query)
  local status, body = send(self.options, "GET", path, nil)
  if status < 200 or status >= 300 then
    return nil, { status = status, body = body as client.GetUsersErrorBody }
  end
  return body as client.GetUsersResponse
end

function client.Client:get_users_id(args: client.GetUsersIdArgs): client.GetUsersIdResponse, client.GetUsersIdError
  local path = "/users/{id}"
  path = fill(path, "id", args.params.id)
  local status, body = send(self.options, "GET", path, nil)
  if status < 200 or status >= 300 then
    return nil, { status = status, body = body as client.GetUsersIdErrorBody }
  end
  return body as client.GetUsersIdResponse
end

